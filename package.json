{
	"name": "skills-sync",
	"version": "1.0.16",
	"description": "Your AI agent skills as a Base: edit them as Markdown notes, tick one checkbox column per agent, and keep real copies in sync with Claude Code, Codex, Hermes and other agents.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"presets:update": "node scripts/update-presets.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"agent-skills",
		"claude-code",
		"codex",
		"skills"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"diff": "^9.0.0",
		"node-diff3": "^3.2.1",
		"yaml": "^2.9.1"
	},
	"author": "Benoit Jadinon",
	"repository": {
		"type": "git",
		"url": "https://github.com/benoitjadinon/obsidian-skills-sync.git"
	}
}
